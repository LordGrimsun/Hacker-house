# ==============================================================================
# TigerGraph Savanna Cloud & tigergraph-mcp Configuration
# TigerGraph Cloud: https://savanna.tgcloud.io/
# TigerGraph MCP:   https://github.com/tigergraph/tigergraph-mcp
# ==============================================================================

# TigerGraph Savanna Instance Connection
# Replace with your actual Savanna Cloud instance URL (e.g., https://your-instance.i.tgcloud.io)
TG_HOST=https://your-instance.i.tgcloud.io
TG_GRAPHNAME=FraudInvestigationGraph
TG_USERNAME=tigergraph
TG_PASSWORD=your_savanna_password
TG_TGCLOUD=true
TG_SSL_PORT=443
TG_RESTPP_PORT=443
TG_GS_PORT=14240

# Optional: TigerGraph API Token / Secret
# If TG_API_TOKEN is supplied, tigergraph-mcp authenticates via Bearer token
TG_API_TOKEN=your_savanna_api_token
TG_SECRET=your_gsql_secret

# tigergraph-mcp Server Settings
# Supported transports: stdio, streamable-http, sse
TG_LOG_TOOL_CALLS=true
TG_LOG_CALLER_IDENTITY=profile
TG_DEFAULT_PROFILE=savanna_cloud

# Secondary Profile: Local TigerGraph Community Edition (Fallback)
LOCAL_TG_HOST=http://127.0.0.1
LOCAL_TG_GRAPHNAME=FraudInvestigationGraph
LOCAL_TG_USERNAME=tigergraph
LOCAL_TG_PASSWORD=tigergraph
LOCAL_TG_TGCLOUD=false
LOCAL_TG_RESTPP_PORT=9000
LOCAL_TG_GS_PORT=14240
